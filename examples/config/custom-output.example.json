{
  "version": "1.0.0",
  "shell": {
    "auto_detect": true,
    "type": ""
  },
  "output": {
    "directory": "~",
    "filename": ".zshrc-test"
  },
  "modules": {
    "enabled": [
      "git-shortcuts",
      "docker-basics",
      "productivity-tools"
