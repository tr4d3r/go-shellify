{
  "name": "core-secrets",
  "version": "1.0.0",
  "description": "Cross-platform OS secret manager integration",
  "category": "security",
  "platforms": ["darwin", "linux", "windows"],
  "shells": ["bash", "zsh", "fish"],
  "author": "go-shellify",
  "repository": "https://github.com/griffin/shellify-registry",
  "functions": [
    {
      "name": "secret_set",
      "description": "Store a secret in OS-native secret manager",
      "commands": [
        "local service=\"$1\"",
        "local account=\"$2\"",
        "local secret=\"$3\"",
        "",
        "if [ -z \"$service\" ] || [ -z \"$account\" ] || [ -z \"$secret\" ]; then",
        "    echo \"Usage: secret_set <service> <account> <secret>\" >&2",
        "    return 1",
        "fi",
        "",
        "case \"$(uname -s)\" in",
        "    Darwin)",
        "        # macOS Keychain",
        "        security add-generic-password -U -a \"$account\" -s \"go-shellify.$service\" -w \"$secret\" 2>/dev/null",
        "        if [ $? -eq 0 ]; then",
        "            echo \"✅ Secret stored for $service/$account\"",
        "        else",
        "            echo \"❌ Failed to store secret for $service/$account\" >&2",
        "            return 1",
        "        fi",
        "        ;;",
        "    MINGW*|CYGWIN*|MSYS*)",
        "        # Windows Credential Manager",
        "        cmdkey /generic:\"go-shellify.$service/$account\" /user:\"$account\" /pass:\"$secret\" >nul 2>&1",
        "        if [ $? -eq 0 ]; then",
        "            echo \"✅ Secret stored for $service/$account\"",
        "        else",
        "            echo \"❌ Failed to store secret for $service/$account\" >&2",
        "            return 1",
        "        fi",
        "        ;;",
        "    Linux)",
        "        # Try libsecret first, then pass",
        "        if command -v secret-tool >/dev/null 2>&1; then",
        "            echo \"$secret\" | secret-tool store --label=\"go-shellify $service/$account\" service \"go-shellify.$service\" account \"$account\" 2>/dev/null",
        "            if [ $? -eq 0 ]; then",
        "                echo \"✅ Secret stored for $service/$account\"",
        "            else",
        "                echo \"❌ Failed to store secret for $service/$account\" >&2",
        "                return 1",
        "            fi",
        "        elif command -v pass >/dev/null 2>&1; then",
        "            echo \"$secret\" | pass insert -e \"go-shellify/$service/$account\" >/dev/null 2>&1",
        "            if [ $? -eq 0 ]; then",
        "                echo \"✅ Secret stored for $service/$account\"",
        "            else",
        "                echo \"❌ Failed to store secret for $service/$account\" >&2",
        "                return 1",
        "            fi",
        "        else",
        "            echo \"❌ No supported secret manager found (install libsecret-tools or pass)\" >&2",
        "            return 1",
        "        fi",
        "        ;;",
        "    *)",
        "        echo \"❌ Unsupported platform: $(uname -s)\" >&2",
        "        return 1",
        "        ;;",
        "esac"
      ]
    },
    {
      "name": "secret_get",
      "description": "Retrieve a secret from OS-native secret manager",
      "commands": [
        "local service=\"$1\"",
        "local account=\"$2\"",
        "",
        "if [ -z \"$service\" ] || [ -z \"$account\" ]; then",
        "    echo \"Usage: secret_get <service> <account>\" >&2",
        "    return 1",
        "fi",
        "",
        "case \"$(uname -s)\" in",
        "    Darwin)",
        "        # macOS Keychain",
        "        security find-generic-password -a \"$account\" -s \"go-shellify.$service\" -w 2>/dev/null",
        "        ;;",
        "    MINGW*|CYGWIN*|MSYS*)",
        "        # Windows Credential Manager (requires PowerShell for retrieval)",
        "        powershell -Command \"",
        "            try {",
        "                \\$cred = Get-StoredCredential -Target 'go-shellify.$service/$account' -ErrorAction Stop;",
        "                [Runtime.InteropServices.Marshal]::PtrToStringAuto([Runtime.InteropServices.Marshal]::SecureStringToBSTR(\\$cred.Password))",
        "            } catch {",
        "                exit 1",
        "            }",
        "        \" 2>/dev/null",
        "        ;;",
        "    Linux)",
        "        # Try libsecret first, then pass",
        "        if command -v secret-tool >/dev/null 2>&1; then",
        "            secret-tool lookup service \"go-shellify.$service\" account \"$account\" 2>/dev/null",
        "        elif command -v pass >/dev/null 2>&1; then",
        "            pass \"go-shellify/$service/$account\" 2>/dev/null",
        "        else",
        "            echo \"❌ No supported secret manager found\" >&2",
        "            return 1",
        "        fi",
        "        ;;",
        "    *)",
        "        echo \"❌ Unsupported platform: $(uname -s)\" >&2",
        "        return 1",
        "        ;;",
        "esac"
      ]
    },
    {
      "name": "secret_delete",
      "description": "Delete a secret from OS-native secret manager",
      "commands": [
        "local service=\"$1\"",
        "local account=\"$2\"",
        "",
        "if [ -z \"$service\" ] || [ -z \"$account\" ]; then",
        "    echo \"Usage: secret_delete <service> <account>\" >&2",
        "    return 1",
        "fi",
        "",
        "case \"$(uname -s)\" in",
        "    Darwin)",
        "        # macOS Keychain",
        "        security delete-generic-password -a \"$account\" -s \"go-shellify.$service\" 2>/dev/null",
        "        if [ $? -eq 0 ]; then",
        "            echo \"✅ Secret deleted for $service/$account\"",
        "        else",
        "            echo \"❌ Failed to delete secret for $service/$account (may not exist)\" >&2",
        "            return 1",
        "        fi",
        "        ;;",
        "    MINGW*|CYGWIN*|MSYS*)",
        "        # Windows Credential Manager",
        "        cmdkey /delete:\"go-shellify.$service/$account\" >nul 2>&1",
        "        if [ $? -eq 0 ]; then",
        "            echo \"✅ Secret deleted for $service/$account\"",
        "        else",
        "            echo \"❌ Failed to delete secret for $service/$account (may not exist)\" >&2",
        "            return 1",
        "        fi",
        "        ;;",
        "    Linux)",
        "        # Try libsecret first, then pass",
        "        if command -v secret-tool >/dev/null 2>&1; then",
        "            secret-tool clear service \"go-shellify.$service\" account \"$account\" 2>/dev/null",
        "            if [ $? -eq 0 ]; then",
        "                echo \"✅ Secret deleted for $service/$account\"",
        "            else",
        "                echo \"❌ Failed to delete secret for $service/$account (may not exist)\" >&2",
        "                return 1",
        "            fi",
        "        elif command -v pass >/dev/null 2>&1; then",
        "            pass rm \"go-shellify/$service/$account\" >/dev/null 2>&1",
        "            if [ $? -eq 0 ]; then",
        "                echo \"✅ Secret deleted for $service/$account\"",
        "            else",
        "                echo \"❌ Failed to delete secret for $service/$account (may not exist)\" >&2",
        "                return 1",
        "            fi",
        "        else",
        "            echo \"❌ No supported secret manager found\" >&2",
        "            return 1",
        "        fi",
        "        ;;",
        "    *)",
        "        echo \"❌ Unsupported platform: $(uname -s)\" >&2",
        "        return 1",
        "        ;;",
        "esac"
      ]
    },
    {
      "name": "secret_list",
      "description": "List secrets for a service",
      "commands": [
        "local service=\"$1\"",
        "",
        "if [ -z \"$service\" ]; then",
        "    echo \"Usage: secret_list <service>\" >&2",
        "    return 1",
        "fi",
        "",
        "echo \"🔐 Secrets for service: $service\"",
        "case \"$(uname -s)\" in",
        "    Darwin)",
        "        # macOS Keychain - list accounts for the service",
        "        security dump-keychain 2>/dev/null | grep -A 1 \"go-shellify.$service\" | grep '\"acct\"' | sed 's/.*\"acct\"<blob>=//;s/\".*$//' | sort -u",
        "        ;;",
        "    MINGW*|CYGWIN*|MSYS*)",
        "        # Windows - list credentials",
        "        cmdkey /list 2>nul | grep \"go-shellify.$service\" | sed 's/.*Target: //' | sort -u",
        "        ;;",
        "    Linux)",
        "        if command -v secret-tool >/dev/null 2>&1; then",
        "            # This is limited - libsecret doesn't have great listing",
        "            echo \"  (libsecret doesn't support comprehensive listing)\"",
        "            echo \"  Try: secret-tool search service go-shellify.$service\"",
        "        elif command -v pass >/dev/null 2>&1; then",
        "            pass ls \"go-shellify/$service\" 2>/dev/null | grep -v \"^go-shellify/$service$\" || echo \"  (no secrets found)\"",
        "        else",
        "            echo \"❌ No supported secret manager found\" >&2",
        "            return 1",
        "        fi",
        "        ;;",
        "    *)",
        "        echo \"❌ Unsupported platform: $(uname -s)\" >&2",
        "        return 1",
        "        ;;",
        "esac"
      ]
    },
    {
      "name": "secret_env",
      "description": "Load secrets as environment variables",
      "commands": [
        "local service=\"$1\"",
        "",
        "if [ -z \"$service\" ]; then",
        "    echo \"Usage: secret_env <service>\" >&2",
        "    echo \"Example: secret_env github  # loads GITHUB_TOKEN from github/token\"",
        "    return 1",
        "fi",
        "",
        "# Common mappings for popular services",
        "case \"$service\" in",
        "    github)",
        "        local token=$(secret_get github token 2>/dev/null)",
        "        if [ -n \"$token\" ]; then",
        "            export GITHUB_TOKEN=\"$token\"",
        "            echo \"✅ Loaded GITHUB_TOKEN\"",
        "        else",
        "            echo \"❌ No token found for github/token\" >&2",
        "            echo \"   Store with: secret_set github token <your-token>\" >&2",
        "        fi",
        "        ;;",
        "    aws)",
        "        local access_key=$(secret_get aws access-key 2>/dev/null)",
        "        local secret_key=$(secret_get aws secret-key 2>/dev/null)",
        "        if [ -n \"$access_key\" ] && [ -n \"$secret_key\" ]; then",
        "            export AWS_ACCESS_KEY_ID=\"$access_key\"",
        "            export AWS_SECRET_ACCESS_KEY=\"$secret_key\"",
        "            echo \"✅ Loaded AWS credentials\"",
        "        else",
        "            echo \"❌ AWS credentials not found\" >&2",
        "            echo \"   Store with: secret_set aws access-key <key> && secret_set aws secret-key <secret>\" >&2",
        "        fi",
        "        ;;",
        "    docker)",
        "        local token=$(secret_get docker token 2>/dev/null)",
        "        if [ -n \"$token\" ]; then",
        "            export DOCKER_TOKEN=\"$token\"",
        "            echo \"✅ Loaded DOCKER_TOKEN\"",
        "        else",
        "            echo \"❌ No token found for docker/token\" >&2",
        "            echo \"   Store with: secret_set docker token <your-token>\" >&2",
        "        fi",
        "        ;;",
        "    *)",
        "        echo \"❌ Unknown service: $service\" >&2",
        "        echo \"Supported services: github, aws, docker\" >&2",
        "        return 1",
        "        ;;",
        "esac"
      ]
    }
  ],
  "checks": [
    {
      "type": "command",
      "command": "uname -s",
      "description": "Check platform support",
      "on_success": [
        "echo \"Platform: $(uname -s) - supported\""
      ],
      "on_failure": [
        "echo \"Warning: Platform detection failed\""
      ]
    }
  ],
  "aliases": [
    {
      "name": "secrets",
      "command": "echo \"🔐 go-shellify secrets module loaded. Available commands:\"; echo \"  secret_set <service> <account> <secret>\"; echo \"  secret_get <service> <account>\"; echo \"  secret_delete <service> <account>\"; echo \"  secret_list <service>\"; echo \"  secret_env <service>\""
    }
  ]
}